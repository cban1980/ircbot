# Runtime config, data and secrets: never commit these.
# config.yml holds server/admin settings, data/ holds password hashes,
# secret/ holds the pepper. Use config.example.yml as the template.
/config.yml
/data/
/secret/
/instance/
/gems/
/gems.lock
*.key
*.pem
.env
.env.*

# The keeper's socket (bin/gemdrop-keeper), if run outside instance/
/run/
*.sock

# Backups made by bin/gemdrop-docker backup (contain the pepper, password
# hashes and API keys)
*.tar
*.tar.gz
*.tgz
gemdrop-backup-*

# Logs and test-run leftovers
*.log
testrun.*
*.pid
status.json

# Ruby / tooling
/.bundle/
/vendor/
/coverage/
/tmp/
*.gem
.ruby-version
.mise.toml
.claude/

# Editors and OS
.vscode/
.idea/
.zed/
*.swp
*~
.DS_Store
