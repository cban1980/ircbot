# systemd unit with sandboxing. Assumes the bot lives in /opt/ircbot and
# runs as a dedicated "ircbot" user:
#
#   sudo useradd --system --home-dir /opt/ircbot --shell /usr/bin/nologin ircbot
#   sudo chown -R ircbot:ircbot /opt/ircbot && sudo chmod 700 /opt/ircbot
#   sudo -u ircbot /opt/ircbot/bin/ircbot-account register <admin>   # creates pepper + data
#   sudo cp contrib/ircbot.service /etc/systemd/system/ && sudo systemctl enable --now ircbot
#
# Secrets can live in /etc/ircbot/env (root-owned, mode 600) instead of files:
#   IRCBOT_PEPPER=<64 hex chars>   IRCBOT_YOUTUBE_API_KEY=<key>

[Unit]
Description=IRC registration and channel mode bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ircbot
Group=ircbot
WorkingDirectory=/opt/ircbot
ExecStart=/usr/bin/ruby /opt/ircbot/bin/ircbot /opt/ircbot/config.yml
EnvironmentFile=-/etc/ircbot/env
Restart=on-failure
RestartSec=30
UMask=0077

# Filesystem: everything read-only except the data directory.
ProtectSystem=strict
ReadWritePaths=/opt/ircbot/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel and system state.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Privileges.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
PrivateUsers=yes
RemoveIPC=yes

# Syscalls and execution. (MemoryDenyWriteExecute is incompatible with
# Ruby's YJIT; the bot does not enable YJIT.)
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes

# Network: IPv4/IPv6 sockets, plus Unix sockets for name resolution.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Resource limits.
MemoryMax=256M
TasksMax=32
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
