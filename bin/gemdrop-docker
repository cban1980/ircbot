#!/usr/bin/env bash
# Build, run and manage the IRC bot in a Docker container.
#
# Everything the bot needs at runtime lives in one host folder (the
# "instance"), mounted at /bot in the container and editable on the host:
#
#   <instance>/config.yml   settings ("edit" or edit by hand, then "reload")
#   <instance>/data/        accounts, channels, known servers, status
#   <instance>/secret/      password pepper (back it up!)
#   <instance>/plugins/     plugin files (*.rb), loaded live on "reload"
#
# Moving to another server: "backup" here, copy the file and this repo
# over, then "restore FILE" and "start" there.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PROG=$(basename "$0")
DIR=${GEMDROP_DIR:-$REPO/instance}
NAME=${GEMDROP_NAME:-gemdrop}
IMAGE=${GEMDROP_IMAGE:-gemdrop:latest}
BRANCH=${GEMDROP_BRANCH:-main}

usage() {
  cat <<EOF
Usage: $PROG [global options] <command> [options]

Global options:
  -d, --dir DIR       instance folder        (default: \$GEMDROP_DIR or <repo>/instance)
  -n, --name NAME     container name         (default: \$GEMDROP_NAME or gemdrop)
  -i, --image IMAGE   image tag              (default: \$GEMDROP_IMAGE or gemdrop:latest)
  -h, --help          show this help

Setup:
  init [--empty]            create the instance folder; copies config.yml, data/ and
                            secret/ from the repo if present (--empty: example config)
  build [--no-cache]        pull debian:trixie-slim and build the image
  check                     validate config.yml, data and pepper without touching the bot
  test                      run the test suite in a trixie container

Running:
  start [options]           start the bot (builds the image if missing)
      --debug               log level debug (logs raw IRC traffic, passwords redacted)
      --log-level LEVEL     debug, info, warn or error (default: info)
      --foreground          run attached in this terminal; Ctrl-C stops it
      --rebuild             rebuild the image first
      --restart-policy P    docker restart policy (default: unless-stopped)
      --memory SIZE         memory limit (default: 512m; password hashing
                            uses ~64 MB per worker process)
  stop [--timeout N] [--keep-irc]
                            stop the bot and the keeper (quits IRC); --keep-irc
                            stops only the bot, the keeper stays on IRC
  restart [--rebuild] [--all] [start options]
                            check the config, then replace the bot's container;
                            the keeper keeps it on IRC meanwhile (no quit, no
                            rejoin, logins kept). --all restarts the keeper too,
                            which leaves IRC once (only for keeper code updates)
  reload                    apply config.yml and data changes live, without
                            reconnecting (unless connection settings changed)
  reconnect                 drop the IRC connection and reconnect
  plugin list               loaded plugins, their commands and load errors
  plugin install FILE.rb    copy a plugin into the instance (private permissions)
                            and load it if the bot is running
  plugin remove NAME        delete a plugin file and unload it if running
  plugin [-n NET] load|unload NAME
                            load a plugin, or keep it unloaded (remembered per
                            network across restarts; all networks without -n)
  plugin [-n NET] set NAME SETTING VALUE
                            save a plugin setting (overrides config.yml); e.g.
                            plugin -n EFnet set links message_type notice
  plugin [-n NET] unset NAME SETTING
                            forget a saved setting
  plugin [-n NET] settings NAME
                            show a plugin's settings and which are saved
  plugin reload             load new plugin files, reload changed ones and
                            re-read config.yml (same as reload)
  update [--no-pull] [--no-restart]
                            pull \$GEMDROP_BRANCH (default: main) from origin, rebuild on
                            the latest base image, restart the bot if running
                            (it stays on IRC)

Inspecting:
  status [--json]           container state, health, server, nick and channels
  logs [--keeper] [-f] [-n N] [--since TIME]
                            show the log (-f follow, -n last N lines; --keeper:
                            the keeper's log)
  shell                     shell in a throwaway container with the same mounts

Accounts and channels (work while the bot runs):
  account list
  account register|passwd|delete NICK     password prompts are hidden
  channel list
  channel show #CHAN
  channel register #CHAN OWNER            the bot joins after an automatic reload
  channel drop #CHAN                      the bot leaves after an automatic reload
  channel mask-add #CHAN MASK voice|op    auto-mode on join for nick!user@host
                                          (exact host, e.g. '*!*me@home.example.net')
  channel mask-del #CHAN MASK
  channel -n NETWORK ...                  pick the network (needed with several
                                          networks; accounts are shared by all)

Configuration:
  edit                      open config.yml in \$EDITOR, check it, reload if running

Backup and migration:
  backup [FILE]             archive config.yml, data/, secret/ and plugins/ (contains the
                            pepper and password hashes: keep it private)
  restore FILE [--force]    unpack a backup into the instance folder
  clean [--images]          remove the containers (and the images)

Instance folder: $DIR
EOF
}

die() { echo "$PROG: $*" >&2; exit 1; }
info() { echo "==> $*"; }

[ "$(id -u)" -ne 0 ] || die "run this as your normal user (in the docker group), not as root"

# --- global options ----------------------------------------------------------

while [ $# -gt 0 ]; do
  case "$1" in
    -d|--dir) [ $# -ge 2 ] || die "$1 needs a value"; DIR=$2; shift 2 ;;
    -n|--name) [ $# -ge 2 ] || die "$1 needs a value"; NAME=$2; shift 2 ;;
    -i|--image) [ $# -ge 2 ] || die "$1 needs a value"; IMAGE=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option $1 (see $PROG --help)" ;;
    *) break ;;
  esac
done
case "$DIR" in /*) ;; *) DIR=$(pwd)/$DIR ;; esac
TEST_IMAGE=${IMAGE%:*}:test
# The keeper holds the IRC connections, so the bot's container can be
# replaced (restart, update) without leaving IRC; see lib/gemdrop/keeper.rb.
KEEPER=$NAME-keeper
KEEPER_SOCKET=/bot/run/keeper.sock
# The code the keeper runs; when it changes, only "restart --all" applies it.
KEEPER_FILES=(lib/gemdrop/keeper.rb lib/gemdrop/connection.rb lib/gemdrop/known_servers.rb
              lib/gemdrop/message.rb lib/gemdrop/casemap.rb lib/gemdrop/log_formatter.rb bin/gemdrop-keeper)
STATUS_FILE=$DIR/data/status.json

# --- helpers -------------------------------------------------------------------

require_docker() {
  command -v docker >/dev/null || die "docker is not installed"
  docker info >/dev/null 2>&1 || die "cannot reach Docker; is the service running and are you in the docker group?"
}

require_instance() {
  [ -f "$DIR/config.yml" ] || die "no config at $DIR/config.yml; run: $PROG init"
}

container_state() {
  # Some Docker versions print an empty line before failing for a missing
  # container, so only trust the output when inspect succeeds.
  local state
  if state=$(docker container inspect --format '{{.State.Status}}' "${1:-$NAME}" 2>/dev/null) && [ -n "$state" ]; then
    echo "$state"
  else
    echo "absent"
  fi
}

remove_container() {
  docker rm "$NAME" >/dev/null 2>&1 || true
}

is_running() { [ "$(container_state)" = "running" ]; }

require_running() {
  is_running || die "$NAME is not running (start it with: $PROG start)"
}

# --- the keeper ---------------------------------------------------------------------

keeper_state() { container_state "$KEEPER"; }

keeper_code() { (cd "$REPO" && cat "${KEEPER_FILES[@]}") | sha256sum | cut -c1-16; }

# True if the running keeper runs older code than this checkout.
keeper_outdated() {
  local running
  running=$(docker container inspect --format '{{index .Config.Labels "gemdrop.keeper-code"}}' "$KEEPER" 2>/dev/null) || return 1
  [ "$running" != "$(keeper_code)" ]
}

start_keeper() {
  case "$(keeper_state)" in
    running) return ;;
    absent) ;;
    *) docker rm "$KEEPER" >/dev/null 2>&1 || true ;;
  esac
  mkdir -p "$DIR/run"
  chmod 700 "$DIR/run"
  rm -f "$DIR/run/keeper.sock" # left by a keeper that was killed
  base_run_opts
  docker run --detach --restart unless-stopped --no-healthcheck \
    --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
    "${run_opts[@]}" --name "$KEEPER" --memory 128m \
    --env GEMDROP_LOG_LEVEL="${GEMDROP_LOG_LEVEL:-info}" \
    --label "gemdrop.keeper=$DIR" --label "gemdrop.keeper-code=$(keeper_code)" \
    --entrypoint ruby "$IMAGE" /app/bin/gemdrop-keeper "$KEEPER_SOCKET" >/dev/null
  local tries=0
  until [ -S "$DIR/run/keeper.sock" ]; do
    tries=$((tries + 1))
    [ "$(keeper_state)" = "running" ] && [ $tries -lt 50 ] || { docker logs --tail 20 "$KEEPER" >&2; die "the keeper didn't start"; }
    sleep 0.2
  done
  info "Started $KEEPER (holds the IRC connections while the bot restarts)"
}

# Quits IRC on every network.
stop_keeper() {
  [ "$(keeper_state)" != "absent" ] || return 0
  docker stop --time 20 "$KEEPER" >/dev/null 2>&1 || true
  docker rm "$KEEPER" >/dev/null 2>&1 || true
  info "Stopped $KEEPER (left IRC)"
}

ensure_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 || cmd_build
}

# Hardened options for every container that touches the instance folder.
# It runs as your user, so files in the instance folder stay yours.
base_run_opts() {
  run_opts=(
    --user "$(id -u):$(id -g)"
    --volume "$DIR:/bot"
    --read-only
    --tmpfs /tmp:rw,noexec,nosuid,nodev,size=16m
    --cap-drop ALL
    --security-opt no-new-privileges
    --pids-limit 128
    --init
    # This machine, for services on it such as a local AI model server
    # (http://host.docker.internal:11434 for Ollama; see docs/ai.md).
    --add-host host.docker.internal:host-gateway
  )
}

# Runs a one-off command from the image with the instance mounted.
run_tool() {
  local tty=()
  [ -t 0 ] && [ -t 1 ] && tty=(--interactive --tty)
  base_run_opts
  docker run --rm "${tty[@]}" "${run_opts[@]}" --memory 256m --entrypoint ruby "$IMAGE" "$@"
}

# Shows the bot's log lines since a timestamp, e.g. the result of a reload.
show_log_since() {
  local since=$1 wait_for=${2:-2}
  sleep "$wait_for"
  docker logs --since "$since" "$NAME" 2>&1 | sed 's/^/    /'
}

now_rfc3339() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Fast-forwards the repo to origin/$BRANCH; sets pulled=true if HEAD moved.
# Config, data and secrets are gitignored, so they are never touched.
pull_repo() {
  command -v git >/dev/null || die "git is not installed"
  git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "$REPO is not a git checkout; clone the repo there (or pass --no-pull)"
  local branch before after
  branch=$(git -C "$REPO" symbolic-ref --quiet --short HEAD) || die "$REPO is not on a branch; check out $BRANCH first"
  [ "$branch" = "$BRANCH" ] || die "$REPO is on branch $branch, not $BRANCH; check out $BRANCH first (or pass --no-pull)"
  [ -z "$(git -C "$REPO" status --porcelain --untracked-files=no)" ] \
    || die "$REPO has uncommitted changes; commit or stash them first (or pass --no-pull)"
  before=$(git -C "$REPO" rev-parse HEAD)
  info "Pulling $BRANCH from origin"
  git -C "$REPO" pull --ff-only --quiet origin "$BRANCH" || die "pull failed; nothing rebuilt"
  after=$(git -C "$REPO" rev-parse HEAD)
  if [ "$before" = "$after" ]; then
    pulled=false
    echo "    already up to date ($(git -C "$REPO" log -1 --format='%h %s'))"
  else
    pulled=true
    git -C "$REPO" log --oneline "$before..$after" | sed 's/^/    /'
  fi
}

# --- commands ----------------------------------------------------------------

cmd_init() {
  local empty=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --empty) empty=true; shift ;;
      *) die "init: unknown option $1" ;;
    esac
  done
  if [ -f "$DIR/config.yml" ]; then
    echo "$DIR already has a config.yml; leaving it alone."
    return
  fi
  mkdir -p "$DIR"
  if ! $empty && [ -f "$REPO/config.yml" ] && [ "$DIR" != "$REPO" ]; then
    cp -a "$REPO/config.yml" "$DIR/"
    for sub in data secret; do
      [ -d "$REPO/$sub" ] && cp -a "$REPO/$sub" "$DIR/"
    done
    rm -f "$DIR/data/status.json"
    info "Copied config.yml, data/ and secret/ from $REPO into $DIR"
  else
    cp "$REPO/config.example.yml" "$DIR/config.yml"
    info "Created $DIR/config.yml from the example; edit it before starting ($PROG edit)"
  fi
  mkdir -p "$DIR/data" "$DIR/secret" "$DIR/plugins"
  # Link previews, HELP, channel services and CTCP answers are plugins; new
  # instances get them (remove to opt out).
  for plugin in links help chanserv ctcp; do
    [ -e "$DIR/plugins/$plugin.rb" ] || install -m 600 "$REPO/contrib/plugins/$plugin.rb" "$DIR/plugins/$plugin.rb"
  done
  chmod -R go-rwx "$DIR" # everything private to you, copied files included
  echo "Next: $PROG account register <yournick>   (if you have no account yet)"
  echo "      $PROG start"
}

cmd_build() {
  local opts=(--pull)
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-cache) opts+=(--no-cache); shift ;;
      *) die "build: unknown option $1" ;;
    esac
  done
  info "Building $IMAGE (debian:trixie-slim, Ruby 3.3)"
  docker build "${opts[@]}" --target runtime --tag "$IMAGE" "$REPO"
}

cmd_check() {
  require_instance
  ensure_image
  run_tool /app/bin/gemdrop --check /bot/config.yml
}

cmd_start() {
  local log_level=${GEMDROP_LOG_LEVEL:-info} foreground=false rebuild=false
  local policy=unless-stopped memory=512m
  while [ $# -gt 0 ]; do
    case "$1" in
      --debug) log_level=debug; shift ;;
      --log-level) [ $# -ge 2 ] || die "--log-level needs a value"; log_level=$2; shift 2 ;;
      --foreground) foreground=true; shift ;;
      --rebuild) rebuild=true; shift ;;
      --restart-policy) [ $# -ge 2 ] || die "--restart-policy needs a value"; policy=$2; shift 2 ;;
      --memory) [ $# -ge 2 ] || die "--memory needs a value"; memory=$2; shift 2 ;;
      *) die "start: unknown option $1" ;;
    esac
  done
  case "$log_level" in debug|info|warn|error) ;; *) die "unknown log level $log_level" ;; esac
  require_instance
  if $rebuild; then cmd_build; else ensure_image; fi

  case "$(container_state)" in
    running) echo "$NAME is already running (use: $PROG restart)"; return ;;
    absent) ;;
    *) remove_container ;;
  esac
  cmd_check >/dev/null || die "config check failed; fix it first (details: $PROG check)"

  start_keeper
  base_run_opts
  run_opts+=(
    --name "$NAME"
    --memory "$memory"
    --env GEMDROP_LOG_LEVEL="$log_level"
    --env GEMDROP_KEEPER_SOCKET="$KEEPER_SOCKET"
    --label "gemdrop.instance=$DIR"
  )
  if $foreground; then
    info "Starting $NAME in the foreground (Ctrl-C stops it; the keeper stays on IRC)"
    exec docker run --rm --interactive --tty "${run_opts[@]}" "$IMAGE" /bot/config.yml
  fi

  local since
  since=$(now_rfc3339)
  docker run --detach --restart "$policy" \
    --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
    "${run_opts[@]}" "$IMAGE" /bot/config.yml >/dev/null
  info "Started $NAME (log level $log_level, restart policy $policy)"
  show_log_since "$since" 4
  is_running || die "$NAME stopped right away; see the log above"
}

cmd_stop() {
  local timeout=15 keep_irc=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) [ $# -ge 2 ] || die "--timeout needs a value"; timeout=$2; shift 2 ;;
      --keep-irc) keep_irc=true; shift ;;
      *) die "stop: unknown option $1" ;;
    esac
  done
  case "$(container_state)" in
    absent) echo "$NAME is not running." ;;
    running)
      docker stop --time "$timeout" "$NAME" >/dev/null
      remove_container
      info "Stopped $NAME" ;;
    *) remove_container ;;
  esac
  $keep_irc || stop_keeper
}

# Replaces the bot's container; the keeper keeps it on IRC meanwhile.
# --all also restarts the keeper, which leaves IRC (for keeper updates).
cmd_restart() {
  local start_args=() rebuild=false all=false
  for arg in "$@"; do
    case "$arg" in
      --rebuild) rebuild=true ;;
      --all) all=true ;;
      *) start_args+=("$arg") ;;
    esac
  done
  require_instance
  $rebuild && cmd_build
  ensure_image
  # Check before stopping, so a broken config doesn't take the bot down.
  cmd_check >/dev/null || die "config check failed; the bot keeps running (details: $PROG check)"
  if $all; then cmd_stop; else cmd_stop --keep-irc; fi
  cmd_start "${start_args[@]}"
  if ! $all && keeper_outdated; then
    echo "Note: the keeper runs older code than this checkout. It keeps working; to update it too"
    echo "      (the bot leaves and rejoins IRC once): $PROG restart --all"
  fi
}

cmd_reload() {
  require_running
  cmd_check >/dev/null || die "config check failed; nothing reloaded (details: $PROG check)"
  local since
  since=$(now_rfc3339)
  docker kill --signal HUP "$NAME" >/dev/null
  info "Sent reload to $NAME:"
  show_log_since "$since" 2
}

cmd_reconnect() {
  require_running
  local since
  since=$(now_rfc3339)
  docker kill --signal USR1 "$NAME" >/dev/null
  info "Sent reconnect to $NAME:"
  show_log_since "$since" 5
}

cmd_status() {
  local json=false
  [ "${1:-}" = "--json" ] && json=true
  if $json; then
    [ -f "$STATUS_FILE" ] || die "no status file yet ($STATUS_FILE)"
    cat "$STATUS_FILE"
    return
  fi
  local state health=""
  state=$(container_state)
  if [ "$state" != "absent" ]; then
    health=$(docker container inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$NAME")
  fi
  echo "Container: $NAME  ($state${health:+, $health})"
  local kstate
  kstate=$(keeper_state)
  echo "Keeper:    $KEEPER  ($kstate$([ "$kstate" = running ] && keeper_outdated && echo ', older code: restart --all to update'))"
  echo "Image:     $IMAGE"
  echo "Instance:  $DIR"
  [ -f "$STATUS_FILE" ] || { echo "Bot:       no status yet"; return; }
  local ruby_cmd='
    s = JSON.parse(File.read("/bot/data/status.json"))
    age = Time.now.to_i - s["updated_at_unix"].to_i
    puts "Bot:       #{s["state"]} (updated #{age}s ago)"
    (s["networks"] || {}).each do |id, n|
      puts "Network:   #{id}  #{n["state"]}"
      puts "  Server:    #{n["server"]}:#{n["port"]}#{" (#{n["network"]})" if n["network"]}"
      puts "  Nick:      #{n["nick"]}"
      puts "  Channels:  #{n["channels"].empty? ? "none" : n["channels"].join(" ")}"
      puts "  Since:     #{n["connected_since"] || "-"}"
    end
    plugins = (s["plugins"] || {}).map { |name, p| p["state"] == "loaded" ? name : "#{name} (#{p["state"]})" }
    puts "Plugins:   #{plugins.empty? ? "none" : plugins.join(" ")}"'
  if is_running; then
    docker exec "$NAME" ruby -rjson -e "$ruby_cmd"
  else
    ensure_image
    run_tool -rjson -e "$ruby_cmd"
  fi
}

cmd_logs() {
  local opts=() target=$NAME
  while [ $# -gt 0 ]; do
    case "$1" in
      --keeper) target=$KEEPER; shift ;;
      -f|--follow) opts+=(--follow); shift ;;
      -n|--tail) [ $# -ge 2 ] || die "$1 needs a value"; opts+=(--tail "$2"); shift 2 ;;
      --since) [ $# -ge 2 ] || die "--since needs a value"; opts+=(--since "$2"); shift 2 ;;
      *) die "logs: unknown option $1" ;;
    esac
  done
  [ "$(container_state "$target")" != "absent" ] || die "$target does not exist (start it with: $PROG start)"
  docker logs "${opts[@]}" "$target"
}

cmd_account() {
  [ $# -gt 0 ] || die "usage: $PROG account list | register|passwd|delete NICK"
  case "$1" in
    list) [ $# -eq 1 ] || die "usage: $PROG account list" ;;
    register|passwd|delete) [ $# -eq 2 ] || die "usage: $PROG account $1 NICK" ;;
    *) die "unknown account command $1" ;;
  esac
  require_instance
  ensure_image
  run_tool /app/bin/gemdrop-account --config /bot/config.yml "$@"
}

cmd_channel() {
  local network=()
  if [ "${1:-}" = "-n" ] || [ "${1:-}" = "--network" ]; then
    [ $# -ge 2 ] || die "$1 needs a network name"
    network=(--network "$2")
    shift 2
  fi
  [ $# -gt 0 ] || die "usage: $PROG channel [-n NETWORK] list | show #CHAN | register #CHAN OWNER | drop #CHAN | mask-add #CHAN MASK LEVEL | mask-del #CHAN MASK"
  local action=$1 tool_cmd
  shift
  case "$action" in
    list) [ $# -eq 0 ] || die "usage: $PROG channel list"; tool_cmd=channels ;;
    show) [ $# -eq 1 ] || die "usage: $PROG channel show #CHAN"; tool_cmd=channel-show ;;
    register) [ $# -eq 2 ] || die "usage: $PROG channel register #CHAN OWNER"; tool_cmd=channel-register ;;
    drop) [ $# -eq 1 ] || die "usage: $PROG channel drop #CHAN"; tool_cmd=channel-drop ;;
    mask-add) [ $# -eq 3 ] || die "usage: $PROG channel mask-add #CHAN MASK voice|op"; tool_cmd=channel-mask-add ;;
    mask-del) [ $# -eq 2 ] || die "usage: $PROG channel mask-del #CHAN MASK"; tool_cmd=channel-mask-del ;;
    *) die "unknown channel command $action" ;;
  esac
  require_instance
  ensure_image
  run_tool /app/bin/gemdrop-account --config /bot/config.yml "${network[@]}" "$tool_cmd" "$@"
  if [[ "$action" =~ ^(register|drop)$ ]] && is_running; then
    cmd_reload
  fi
}

cmd_plugin() {
  local usage="usage: $PROG plugin list | install FILE.rb | remove NAME | reload |
       [-n NETWORK] load|unload|settings NAME | set NAME SETTING VALUE | unset NAME SETTING"
  local network=()
  if [ "${1:-}" = "-n" ] || [ "${1:-}" = "--network" ]; then
    [ $# -ge 2 ] || die "$1 needs a network name"
    network=(--network "$2")
    shift 2
  fi
  case "${1:-}" in
    list) [ $# -eq 1 ] || die "$usage" ;;
    install) [ $# -eq 2 ] || die "$usage"; plugin_install "$2"; return ;;
    remove) [ $# -eq 2 ] || die "$usage"; plugin_remove "$2"; return ;;
    reload) [ $# -eq 1 ] || die "$usage"; cmd_reload; return ;;
    load|unload|settings) [ $# -eq 2 ] || die "$usage"; plugin_state "$1" "${network[@]}" "$2"; return ;;
    set) [ $# -ge 4 ] || die "$usage"; plugin_state set "${network[@]}" "${@:2}"; return ;;
    unset) [ $# -eq 3 ] || die "$usage"; plugin_state unset "${network[@]}" "$2" "$3"; return ;;
    *) die "$usage" ;;
  esac
  [ -f "$STATUS_FILE" ] || die "no status file yet ($STATUS_FILE); is the bot running?"
  local ruby_cmd='
    status = JSON.parse(File.read("/bot/data/status.json"))
    by_network = (status["networks"] || {}).transform_values { |n| n["plugins"] || {} }
    by_network = { nil => status["plugins"] || {} } if by_network.empty?
    by_network.each do |network, plugins|
    puts "#{network}:" if network && by_network.size > 1
    indent = network && by_network.size > 1 ? "  " : ""
    puts "#{indent}No plugins (put *.rb files in plugins/ and reload)" if plugins.empty?
    plugins.each do |name, p|
      line = "#{indent}#{name}: #{p["state"]}"
      line += " (kept unloaded; load it with: plugin load #{name})" if p["kept_unloaded"]
      if p["state"] == "loaded"
        where = [("/msg" if p["private"]), ("#{p["prefix"]} in channels" if p["prefix"])].compact
        line += "  commands: #{p["commands"].empty? ? "-" : p["commands"].join(" ")}"
        line += "  via: #{where.empty? ? "events only" : where.join(", ")}"
      end
      line += "  gems: #{p["gems"].join(", ")}" if p["state"] == "installing"
      line += "\n#{indent}    error: #{p["error"]}" if p["error"]
      puts line
    end
    end'
  if is_running; then
    docker exec "$NAME" ruby -rjson -e "$ruby_cmd"
  else
    ensure_image
    run_tool -rjson -e "$ruby_cmd"
  fi
}

# The bot only loads plugin files that only you can write.
plugin_install() {
  local file=$1 name
  name=$(basename "$file" .rb)
  [ -f "$file" ] && [ "$file" != "$name" ] || die "$file is not a .rb file"
  [[ "$name" =~ ^[a-z][a-z0-9_]{0,31}$ ]] || die "plugin file names are lowercase letters, digits and _ (got $name.rb)"
  require_instance
  mkdir -p "$DIR/plugins"
  chmod 700 "$DIR/plugins"
  install -m 600 "$file" "$DIR/plugins/$name.rb"
  info "Installed $DIR/plugins/$name.rb"
  if is_running; then cmd_reload; else echo "It loads when the bot starts."; fi
}

# Plugin load/unload state and saved settings, remembered per network in
# the data file; a running bot applies them right away (reload).
plugin_state() {
  local action=$1 net=()
  shift
  if [ "${1:-}" = "--network" ]; then
    net=(--network "$2")
    shift 2
  fi
  require_instance
  ensure_image
  run_tool /app/bin/gemdrop-account --config /bot/config.yml "${net[@]}" "plugin-$action" "$@"
  if [ "$action" != settings ] && is_running; then
    cmd_reload
  fi
}

plugin_remove() {
  local name=${1%.rb}
  [ -f "$DIR/plugins/$name.rb" ] || die "no plugin $DIR/plugins/$name.rb"
  rm -f "$DIR/plugins/$name.rb"
  info "Removed $DIR/plugins/$name.rb"
  if is_running; then cmd_reload; fi
}

cmd_edit() {
  require_instance
  "${VISUAL:-${EDITOR:-vi}}" "$DIR/config.yml"
  ensure_image
  if ! cmd_check; then
    die "config.yml has problems (shown above); nothing applied. Run '$PROG edit' again to fix it."
  fi
  if is_running; then cmd_reload; fi
}

cmd_backup() {
  require_instance
  local file=${1:-gemdrop-backup-$(date +%Y%m%d-%H%M%S).tar.gz} parts=(config.yml data secret)
  [ -d "$DIR/plugins" ] && parts+=(plugins)
  # gems.lock pins the plugins' gems; the gems themselves are downloaded
  # again after a restore.
  [ -f "$DIR/gems.lock" ] && parts+=(gems.lock)
  case "$file" in /*) ;; *) file=$(pwd)/$file ;; esac
  [ ! -e "$file" ] || die "$file already exists"
  (
    umask 077
    tar -C "$DIR" --exclude='*.tmp' --exclude='*.lock' --exclude='data/status.json' \
      -czf "$file" "${parts[@]}"
  )
  info "Backup written to $file"
  echo "It contains the password pepper and hashes, and any API keys saved with PLUGIN SET: keep it private."
}

cmd_restore() {
  local file="" force=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=true; shift ;;
      -*) die "restore: unknown option $1" ;;
      *) [ -z "$file" ] || die "restore takes one file"; file=$1; shift ;;
    esac
  done
  [ -n "$file" ] || die "usage: $PROG restore FILE [--force]"
  [ -f "$file" ] || die "$file not found"
  if [ "$(container_state)" = "running" ]; then die "stop $NAME first ($PROG stop)"; fi
  if [ -f "$DIR/config.yml" ] && ! $force; then
    die "$DIR already has a config.yml; use --force to overwrite it"
  fi
  # Only accept the expected, relative paths (no absolute paths or "..").
  local entry
  while IFS= read -r entry; do
    case "$entry" in
      config.yml|data|data/*|secret|secret/*|plugins|plugins/*|gems.lock) ;;
      *) die "unexpected entry in backup: $entry" ;;
    esac
    case "$entry" in *..*) die "unsafe path in backup: $entry" ;; esac
  done < <(tar -tzf "$file")
  mkdir -p "$DIR"
  tar -C "$DIR" --no-same-owner --no-same-permissions -xzf "$file"
  chmod -R go-rwx "$DIR"
  info "Restored $file into $DIR"
  echo "Next: $PROG check && $PROG start"
}

cmd_test() {
  info "Building the test image (debian:trixie-slim, Ruby 3.3)"
  docker build --pull --target test --tag "$TEST_IMAGE" "$REPO"
  docker run --rm --user "$(id -u):$(id -g)" --read-only \
    --tmpfs /tmp:rw,nosuid,nodev,size=64m --cap-drop ALL --security-opt no-new-privileges \
    "$TEST_IMAGE" sh -c 'ruby --version && rake test'
}

cmd_update() {
  local restart=true pull=true pulled=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-restart) restart=false; shift ;;
      --no-pull) pull=false; shift ;;
      *) die "update: unknown option $1" ;;
    esac
  done
  $pull && pull_repo
  if $pulled; then
    # The pull may have changed this script too; finish with the new version.
    local again=(update --no-pull)
    $restart || again+=(--no-restart)
    exec "$REPO/bin/$PROG" --dir "$DIR" --name "$NAME" --image "$IMAGE" "${again[@]}"
  fi
  cmd_build
  if $restart && is_running; then
    cmd_restart
  fi
}

cmd_shell() {
  require_instance
  ensure_image
  base_run_opts
  docker run --rm --interactive --tty "${run_opts[@]}" --memory 256m --entrypoint sh "$IMAGE"
}

cmd_clean() {
  cmd_stop
  if [ "${1:-}" = "--images" ]; then
    docker image rm "$IMAGE" "$TEST_IMAGE" 2>/dev/null || true
    info "Removed images $IMAGE and $TEST_IMAGE"
  fi
}

# --- dispatch ------------------------------------------------------------------

command=${1:-help}
[ $# -eq 0 ] || shift
case "$command" in
  init|help|backup|restore) ;;
  build|check|start|stop|restart|reload|reconnect|status|logs|account|channel|plugin|edit|test|update|shell|clean)
    require_docker ;;
  *) echo "$PROG: unknown command '$command'" >&2; usage >&2; exit 1 ;;
esac
case "$command" in
  init) cmd_init "$@" ;;
  build) cmd_build "$@" ;;
  check) cmd_check ;;
  start) cmd_start "$@" ;;
  stop) cmd_stop "$@" ;;
  restart) cmd_restart "$@" ;;
  reload) cmd_reload ;;
  reconnect) cmd_reconnect ;;
  status) cmd_status "$@" ;;
  logs) cmd_logs "$@" ;;
  account) cmd_account "$@" ;;
  channel) cmd_channel "$@" ;;
  plugin) cmd_plugin "$@" ;;
  edit) cmd_edit ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  test) cmd_test ;;
  update) cmd_update "$@" ;;
  shell) cmd_shell ;;
  clean) cmd_clean "$@" ;;
  help) usage ;;
  *) usage >&2; exit 1 ;;
esac
